{
  "name": "Triage an issue",
  "schemas": {
    "triage": {
      "type": "object",
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "enum": ["bug", "feature", "question"] },
        "summary": { "type": "string" }
      }
    },
    "reply": {
      "type": "object",
      "required": ["body"],
      "properties": { "body": { "type": "string" } }
    }
  },
  "input": {
    "type": "object",
    "required": ["issue"],
    "properties": {
      "issue": {
        "type": "object",
        "required": ["number", "title"],
        "properties": {
          "number": { "type": "integer" },
          "title": { "type": "string" }
        }
      }
    }
  },
  "steps": [
    {
      "name": "classify",
      "agent": "triager",
      "output": "triage",
      "with": { "title": "${{ input.issue.title }}" },
      "next": {
        "switch": "classify.kind",
        "cases": { "bug": "reproduce", "feature": "spec", "question": "answer" }
      }
    },
    {
      "name": "reproduce",
      "agent": "engineer",
      "output": "reply",
      "next": ["comment"]
    },
    {
      "name": "spec",
      "agent": "product",
      "output": "reply",
      "next": ["comment"]
    },
    {
      "name": "answer",
      "agent": "support",
      "output": "reply",
      "next": ["comment"]
    },
    {
      "name": "comment",
      "action": "github.comment",
      "with": {
        "issue": "${{ input.issue.number }}",
        "label": "${{ classify.kind }}",
        "body": "${{ classify.summary }}: ${{ coalesce(reproduce, spec, answer).body }}"
      }
    }
  ],
  "outputs": {
    "kind": "${{ classify.kind }}",
    "reply": "${{ coalesce(reproduce, spec, answer).body }}"
  }
}
