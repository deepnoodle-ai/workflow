{
  "name": "Extract invoice totals",
  "input": {
    "type": "object",
    "required": ["docs"],
    "properties": { "docs": { "type": "array", "items": { "type": "string" } } }
  },
  "steps": [
    {
      "name": "extract",
      "action": "llm.extract",
      "each": "input.docs",
      "concurrency": 4,
      "continue_on_error": true,
      "with": { "doc": "${{ item }}" },
      "retry": { "max_attempts": 2, "backoff": "10ms" },
      "output": {
        "type": "object",
        "required": ["doc", "total"],
        "properties": {
          "doc": { "type": "string" },
          "total": { "type": "number" }
        }
      },
      "next": "ok"
    },
    {
      "name": "ok",
      "expr": "filter(extract, it?.error == nil)",
      "next": "dead_letter"
    },
    {
      "name": "dead_letter",
      "expr": "filter(extract, it?.error != nil)"
    }
  ],
  "outputs": {
    "succeeded": "${{ len(ok) }}",
    "failed": "${{ len(dead_letter) }}",
    "errors": "${{ map(dead_letter, it?.error?.message) }}"
  }
}
