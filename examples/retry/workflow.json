{
  "name": "Charge a customer",
  "input": {"type": "object", "required": ["customer"], "properties": {"customer": {"type": "string"}}},
  "steps": [
    {"name": "charge", "action": "payments.charge", "with": {"customer": "${{ input.customer }}", "cents": 4200},
     "output": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
     "timeout": "300ms",
     "retry": {"max_attempts": 3, "backoff": "100ms", "factor": 2, "errors": ["unavailable", "timeout"]},
     "catch": [{"errors": ["card_declined"], "next": "declined"}],
     "next": ["receipt"]},
    {"name": "receipt", "action": "email.receipt", "with": {"charge": "${{ charge.id }}"}},
    {"name": "declined", "action": "email.declined", "with": {"reason": "${{ charge.error.message }}"}}
  ],
  "on_failure": [
    {"name": "page", "action": "pager.page", "with": {"message": "${{ error.step }} failed: ${{ error.message }}"}}
  ],
  "finally": [
    {"name": "audit", "action": "audit.log",
     "with": {"customer": "${{ input.customer }}", "outcome": "${{ run.status }}", "charge": "${{ charge?.id }}"}}
  ],
  "outputs": {
    "charge": {"value": "${{ charge?.id }}", "schema": {"type": ["string", "null"]},
               "description": "The charge's ID, or null if the card was declined."}
  }
}
